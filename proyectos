import math

# ==========================================
# 1. MÓDULO DE CRIPTOGRAFÍA RSA
# ==========================================

def mcd_extendido(a, b):
    if a == 0:
        return b, 0, 1
    mcd, x1, y1 = mcd_extendido(b % a, a)
    x = y1 - (b // a) * x1
    y = x1
    return mcd, x, y

def inverso_modular(e, phi):
    mcd, x, y = mcd_extendido(e, phi)
    if mcd != 1:
        raise Exception("El inverso modular no existe.")
    return x % phi

def generar_claves():
    p, q = 61, 53
    n = p * q
    phi = (p - 1) * (q - 1)
    e = 17
    d = inverso_modular(e, phi)
    return (e, n), (d, n)

def cifrar_rsa(mensaje, clave_publica):
    e, n = clave_publica
    return [pow(ord(char), e, n) for char in mensaje]

def descifrar_rsa(criptograma, clave_privada):
    d, n = clave_privada
    return "".join([chr(pow(c, d, n)) for c in criptograma])

# ==========================================
# 2. MÓDULO CÓDIGO DE HAMMING (7,4)
# ==========================================

def codificar_hamming_bloque(bits4):
    d1, d2, d3, d4 = bits4
    p1 = d1 ^ d2 ^ d4
    p2 = d1 ^ d3 ^ d4
    p3 = d2 ^ d3 ^ d4
    return [d1, d2, d3, d4, p1, p2, p3]

def corregir_hamming_bloque(bits7):
    d1, d2, d3, d4, p1, p2, p3 = bits7
    s1 = p1 ^ d1 ^ d2 ^ d4
    s2 = p2 ^ d1 ^ d3 ^ d4
    s3 = p3 ^ d2 ^ d3 ^ d4
    sindrome = s1 * 1 + s2 * 2 + s3 * 4
    
    # Mapeo de posición de error según síndrome
    posiciones = {0: None, 1: 4, 2: 5, 4: 6, 3: 0, 5: 1, 6: 2, 7: 3}
    pos_error = posiciones.get(sindrome)
    
    if pos_error is not None:
        bits7[pos_error] ^= 1  # Corregir bit invertido
    return bits7[:4], pos_error

# ==========================================
# EXECUCIÓN DEL SISTEMA
# ==========================================
if __name__ == "__main__":
    pub, priv = generar_claves()
    mensaje_original = "ECCI"
    
    print("=== SISTEMA CRIPTO-ROBUSTO ===")
    print(f"Mensaje Original: {mensaje_original}")
    
    # Cifrado RSA
    criptograma = cifrar_rsa(mensaje_original, pub)
    print(f"Criptograma RSA: {criptograma}")
    
    # Simulación de Hamming en transmisión del primer entero cifrado
    val = criptograma[0]
    b_datos = [(val >> i) & 1 for i in range(3, -1, -1)]
    bloque_trans = codificar_hamming_bloque(b_datos)
    
    print(f"\nBloque Hamming (7,4) transmitido: {bloque_trans}")
    
    # Inyección de error en el bit 1
    bloque_trans[1] ^= 1
    print(f"Bloque recibido con Ruido/Error:  {bloque_trans}")
    
    # Corrección
    datos_corregidos, error_pos = corregir_hamming_bloque(bloque_trans)
    print(f"Error detectado y corregido en posición de bit: {error_pos}")
    print(f"Datos recuperados tras corrección: {datos_corregidos}")
    
    # Descifrado RSA final
    mensaje_recuperado = descifrar_rsa(criptograma, priv)
    print(f"\nMensaje final descifrado: {mensaje_recuperado}")

