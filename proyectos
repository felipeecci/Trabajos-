Codigo Grafos:
import heapq

# Grafo de sucursales y distancias en kilómetros
grafo = {
    'A': [('B', 4), ('C', 2)],
    'B': [('A', 4), ('C', 1), ('D', 5), ('E', 9)],
    'C': [('A', 2), ('B', 1), ('D', 8), ('E', 10)],
    'D': [('B', 5), ('C', 8), ('E', 2), ('F', 6)],
    'E': [('B', 9), ('C', 10), ('D', 2), ('F', 3)],
    'F': [('D', 6), ('E', 3)]
}

def dijkstra(grafo, inicio, destino):
    # Distancia inicial infinita para todos los nodos
    distancias = {nodo: float('inf') for nodo in grafo}
    anteriores = {nodo: None for nodo in grafo}

    distancias[inicio] = 0

    # Cola de prioridad
    cola = [(0, inicio)]

    while cola:
        distancia_actual, nodo_actual = heapq.heappop(cola)

        if distancia_actual > distancias[nodo_actual]:
            continue

        if nodo_actual == destino:
            break

        # Revisar los vecinos del nodo actual
        for vecino, peso in grafo[nodo_actual]:
            nueva_distancia = distancia_actual + peso

            if nueva_distancia < distancias[vecino]:
                distancias[vecino] = nueva_distancia
                anteriores[vecino] = nodo_actual

                heapq.heappush(
                    cola, (nueva_distancia, vecino)
                )

    # Reconstruir la ruta más corta
    ruta = []
    actual = destino

    while actual is not None:
        ruta.append(actual)
        actual = anteriores[actual]

    ruta.reverse()

    return distancias[destino], ruta


# Ejecución del programa
origen = 'A'
destino = 'F'

distancia, ruta = dijkstra(grafo, origen, destino)

print("ALGORITMO DE DIJKSTRA")
print("----------------------------")
print("Origen:", origen)
print("Destino:", destino)
print("Ruta más corta:", " -> ".join(ruta))
print("Distancia total:", distancia, "km")

